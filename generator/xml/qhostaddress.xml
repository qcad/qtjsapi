      <key>LocalHostIPv6</key>
      <key>Any</key>
      <key>AnyIPv6</key>
      <key>AnyIPv4</key>
    </enum>
    <enum name="ConversionModeFlag">
      <key>ConvertV4MappedToIPv4</key>
      <key>ConvertV4CompatToIPv4</key>
      <key>ConvertUnspecifiedAddress</key>
      <key>ConvertLocalHost</key>
      <key>TolerantConversion</key>
      <key>StrictConversion</key>
