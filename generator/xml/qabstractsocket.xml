      <key>DefaultForPlatform</key>
      <key>ShareAddress</key>
      <key>DontShareAddress</key>
      <key>ReuseAddressHint</key>
    </enum>
    <enum name="PauseMode">
      <key>PauseNever</key>
      <key>PauseOnSslErrors</key>
    </enum>
