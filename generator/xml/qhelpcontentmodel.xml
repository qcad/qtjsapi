<?xml version="1.0"?>
<unit xmlns="http://qcad.org/namespaces/src" xmlns:qc="http://qcad.org/namespaces/xsl" filename="qhelpcontentmodel.h">
  <class_decl name="QHelpContentItem" />
  <class_decl name="QHelpEngineCore" />
  <class name="QHelpContentModel" ifdef="QT_HELP_LIB" ownership="cpp" nodestructor="true">
    <super_list>
      <super name="QObject" />
      <super name="QAbstractItemModel" />
    </super_list>
    <function name="createContentsForCurrentFilter">
      <variant return-type="void" access="public">
        <parameters />
      </variant>
    </function>
    <function name="createContents">
      <variant return-type="void" access="public">
        <parameters>
          <parameter const="true" type="QString" modifier="&amp;" name="customFilterName" />
        </parameters>
      </variant>
    </function>
    <function name="contentItemAt">
      <variant return-type="QHelpContentItem*" const="true" access="public">
        <parameters>
          <parameter const="true" type="QModelIndex" modifier="&amp;" name="index" />
        </parameters>
      </variant>
    </function>
    <function name="index">
      <variant return-type="QModelIndex" const="true" access="public">
        <parameters>
          <parameter const="false" type="int" modifier="" name="row" />
          <parameter const="false" type="int" modifier="" name="column" />
          <parameter const="true" type="QModelIndex" modifier="&amp;" name="parent" default="QModelIndex()" />
        </parameters>
      </variant>
    </function>
    <function name="parent">
      <variant return-type="QModelIndex" const="true" access="public">
        <parameters>
          <parameter const="true" type="QModelIndex" modifier="&amp;" name="index" />
        </parameters>
      </variant>
    </function>
    <function name="rowCount">
      <variant return-type="int" const="true" access="public">
        <parameters>
          <parameter const="true" type="QModelIndex" modifier="&amp;" name="parent" default="QModelIndex()" />
        </parameters>
      </variant>
    </function>
    <function name="columnCount">
      <variant return-type="int" const="true" access="public">
        <parameters>
          <parameter const="true" type="QModelIndex" modifier="&amp;" name="parent" default="QModelIndex()" />
        </parameters>
      </variant>
    </function>
    <function name="data">
      <variant return-type="QVariant" const="true" access="public">
        <parameters>
          <parameter const="true" type="QModelIndex" modifier="&amp;" name="index" />
          <parameter const="false" type="int" modifier="" name="role" />
        </parameters>
      </variant>
    </function>
    <function name="isCreatingContents">
      <variant return-type="bool" const="true" access="public">
        <parameters />
      </variant>
    </function>
    <function name="contentsCreationStarted">
      <variant return-type="void" access="public" signal="true">
        <parameters />
      </variant>
    </function>
    <function name="contentsCreated">
      <variant return-type="void" access="public" signal="true">
        <parameters />
      </variant>
    </function>
  </class>
</unit>
