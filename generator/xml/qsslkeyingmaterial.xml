<?xml version="1.0"?>
<unit xmlns="http://qcad.org/namespaces/src" xmlns:qc="http://qcad.org/namespaces/xsl" filename="qsslkeyingmaterial.h">
  <class_decl name="QDebug" />
  <class name="QSslKeyingMaterial">
    <constructor>
      <variant>
        <parameters />
      </variant>
      <variant>
        <parameters>
          <parameter const="true" type="QByteArray" modifier="&amp;" name="label" />
          <parameter const="false" type="qsizetype" modifier="" name="size" />
        </parameters>
      </variant>
      <variant>
        <parameters>
          <parameter const="true" type="QByteArray" modifier="&amp;" name="label" />
          <parameter const="false" type="qsizetype" modifier="" name="size" />
          <parameter const="true" type="QByteArray" modifier="&amp;" name="context" />
        </parameters>
      </variant>
    </constructor>
    <function name="isValid">
      <variant return-type="bool" const="true" access="public">
        <parameters />
      </variant>
    </function>
    <function name="label">
      <variant return-type="QByteArray" const="true" access="public">
        <parameters />
      </variant>
    </function>
    <function name="context">
      <variant return-type="QByteArray" const="true" access="public">
        <parameters />
      </variant>
    </function>
    <function name="value">
      <variant return-type="QByteArray" const="true" access="public">
        <parameters />
      </variant>
    </function>
    <function name="requestedSize">
      <variant return-type="qsizetype" const="true" access="public">
        <parameters />
      </variant>
    </function>
    <function name="swap">
      <variant return-type="void" access="public">
        <parameters>
          <parameter const="false" type="QSslKeyingMaterial" modifier="&amp;" name="other" />
        </parameters>
      </variant>
    </function>
    <function name="comparesEqual" />
    <function name="qHash" />
    <function name="qHash" />
    <preproc plain="#ifndef QT_NO_DEBUG_STREAM" />
    <!-- QDebug is not a bindable type
    <function name="operator_read" call="operator&lt;&lt;">
      <variant return-type="QDebug" access="unknown">
        <parameters>
          <parameter const="false" type="QDebug" modifier="" name="debug" />
          <parameter const="true" type="QSslKeyingMaterial" modifier="&amp;" name="keying" />
        </parameters>
      </variant>
    </function>
    -->
    <preproc plain="#endif" />
  </class>
</unit>
