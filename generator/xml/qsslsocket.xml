    </function>
    <function name="startServerEncryption">
      <variant return-type="void" access="public">
        <parameters />
      </variant>
    </function>
    <function name="ignoreSslErrors">
      <variant return-type="void" access="public">
        <parameters />
      </variant>
    </function>
    <function name="encrypted">
      <variant return-type="void" access="public" signal="true">
        <parameters />
      </variant>
    </function>
    <function name="peerVerifyError">
      <variant return-type="void" access="public" signal="true">
        <parameters>
          <parameter const="true" type="QSslError" modifier="&amp;" name="error" />
        </parameters>
      </variant>
    </function>
    <function name="sslErrors">
      <variant return-type="void" access="public" signal="true">
        <parameters>
          <parameter const="true" type="QList&lt;QSslError&gt;" modifier="&amp;" name="errors" />
        </parameters>
      </variant>
    </function>
    <function name="modeChanged">
      <variant return-type="void" access="public" signal="true">
        <parameters>
          <parameter const="false" type="QSslSocket::SslMode" modifier="" name="newMode" />
        </parameters>
      </variant>
    </function>
    <function name="encryptedBytesWritten">
      <variant return-type="void" access="public" signal="true">
        <parameters>
          <parameter const="false" type="qint64" modifier="" name="totalBytes" />
        </parameters>
      </variant>
    </function>
    <function name="preSharedKeyAuthenticationRequired">
      <variant return-type="void" access="public" signal="true">
        <parameters>
          <parameter const="false" type="QSslPreSharedKeyAuthenticator" modifier="*" name="authenticator" />
        </parameters>
      </variant>
    </function>
